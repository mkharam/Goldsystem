# ——— قاعدة بيانات تطبيق الصيانة (مشروع Supabase خاص به وحده) ———
# المتصفح لا يتصل بـ Supabase إطلاقاً، فكل هذه أسرار خادم — بلا NEXT_PUBLIC_.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ——— سرّ توقيع جلسات الموظفين ———
# openssl rand -hex 32
SESSION_SECRET=

# ——— التكامل مع نظام المخزون (jewel-sight-manager) ———
# اتركهما فارغين للعمل بالإدخال اليدوي بالكامل دون أي تكامل.
INVENTORY_API_URL=https://iiyaytfdxfvjcvzlnlpp.supabase.co/functions/v1/repair-api
INVENTORY_API_KEY=

# العنوان العام للتطبيق — يُبنى منه رابط التتبّع داخل رمز QR ورسالة واتساب.
NEXT_PUBLIC_APP_URL=http://localhost:3000
